rules_version = '2';
// SOLO PARA EL EMULADOR LOCAL DE PRUEBAS. Nunca desplegar.
// Las pruebas funcionales verifican la lógica del negocio (stock, dinero,
// transacciones), no las reglas de seguridad, así que aquí todo está abierto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
